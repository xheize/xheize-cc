# Application runtime configuration
PORT=3000
ORIGIN=http://localhost:3000

# xheize sso-server OIDC configuration
SSO_ISSUER=https://dev-sso.xheize.cc
SSO_CLIENT_ID=xheize-cc
SSO_CLIENT_SECRET=replace-with-the-secret-created-by-sso-server

# Generate a random value with at least 32 characters. Changing it signs out all users.
AUTH_SECRET=replace-with-a-long-random-session-secret

# Comma-separated route prefixes. Defaults to /aichat when omitted.
AUTH_PROTECTED_ROUTES=/aichat
